{
  "name": "votewatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "data:download:constituencies": "node --experimental-strip-types scripts/data/download/download-constituencies.ts",
    "data:download:mps": "node --experimental-strip-types scripts/data/download/download-mps.ts",
    "data:download:map": "node --experimental-strip-types scripts/data/download/download-constituency-map.ts",
    "data:download:all": "node --experimental-strip-types scripts/data/download-all.ts",
    "data:build:mps": "node --experimental-strip-types scripts/data/transform/build-mps.ts",
    "data:build:constituencies": "node --experimental-strip-types scripts/data/transform/build-constituencies.ts",
    "data:build:search-index": "node --experimental-strip-types scripts/data/transform/build-search-index.ts",
    "data:build:map": "node --experimental-strip-types scripts/data/transform/build-constituency-geo.ts",
    "data:build:step1": "node --experimental-strip-types scripts/data/build-constituency-data.ts",
    "data:validate:constituencies": "node --experimental-strip-types scripts/data/validate/validate-constituencies.ts",
    "data:validate:mps": "node --experimental-strip-types scripts/data/validate/validate-mps.ts",
    "data:validate:search-index": "node --experimental-strip-types scripts/data/validate/validate-search-index.ts",
    "data:validate:all": "node --experimental-strip-types scripts/data/validate/validate-all.ts",
    "data:step1": "npm run data:download:all && npm run data:build:step1 && npm run data:validate:all"
  },
  "dependencies": {
    "next": "15.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2"
  }
}
